# ============================================================
# .dockerignore — exclude everything that isn't the site
# ============================================================

# Git
.git
.github
.gitignore

# Backups and versions
*_BACKUP_*
*_v1_*
*_v2_*
*_v3_*
*.backup
*.pre-reorder-backup

# Virtual environments (huge)
venv312
.venv
node_modules

# System files
.DS_Store
*.log

# Docker artifacts
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
README.md
LICENSE

# Ship notebooks and repos (not part of the site)
ships/
!ships/manifest.json

# Raw PDFs and certificates not served
*.ipynb
*.eml
*.metadata.json

# ProtonMail exports (huge)
protonmail-export/

# Extracted files
extracted_1/
extracted_manus/

# Any other large folders
markdown_generator/
talkmap/
_drafts/
*.bak-*
