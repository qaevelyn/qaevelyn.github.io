#!/bin/sh
# Mirror guard (pre-push) — scans every pushed path range against the blocklist.
root=$(git rev-parse --show-toplevel) || exit 1
bl="$root/tools/guard-blocklist.txt"
[ -f "$bl" ] || exit 0
empty_tree=$(git hash-object -t tree /dev/null)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="$empty_tree"
  else
    base="$remote_sha"
  fi
  names=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || continue
  [ -z "$names" ] && continue
  while IFS= read -r line; do
    line=$(printf '%s' "$line" | tr -d '\r')
    case "$line" in ''|\#*) continue ;; esac
    if printf '%s\n' "$names" | grep -qF -- "$line"; then
      echo "PUSH BLOCKED by mirror guard — blocklisted path token: $line" >&2
      status=1
    fi
  done < "$bl"
done
exit $status
