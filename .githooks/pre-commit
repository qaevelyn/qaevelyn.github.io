#!/bin/sh
# Mirror guard (pre-commit) — rejects staged paths containing blocklisted material.
root=$(git rev-parse --show-toplevel) || exit 1
bl="$root/tools/guard-blocklist.txt"
[ -f "$bl" ] || exit 0
names=$(git diff --cached --name-only --diff-filter=AMCR)
[ -z "$names" ] && exit 0
status=0
while IFS= read -r line; do
  line=$(printf '%s' "$line" | tr -d '\r')
  case "$line" in ''|\#*) continue ;; esac
  if printf '%s\n' "$names" | grep -qF -- "$line"; then
    echo "COMMIT BLOCKED by mirror guard — blocklisted path token: $line" >&2
    status=1
  fi
done < "$bl"
exit $status
