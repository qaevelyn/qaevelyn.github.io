#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
bl="$root/tools/guard-blocklist.txt"
if [ -f "$bl" ]; then
  names=$(git diff --cached --name-only --diff-filter=AMCR)
  if [ -n "$names" ]; then
    status=0
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      while IFS= read -r line; do
        line=$(printf '%s' "$line" | tr -d '\r')
        case "$line" in ''|\#*) continue ;; esac
        case "$name" in
          $line)
            echo "COMMIT BLOCKED by mirror guard — path '$name' matches blocklist pattern '$line'" >&2
            status=1
            ;;
        esac
      done < "$bl"
    done <<NAMES_EOF
$names
NAMES_EOF
    [ "$status" -ne 0 ] && exit "$status"
  fi
fi
if [ -f "$root/tools/tm_guard.py" ]; then
  python3 "$root/tools/tm_guard.py"
  exit $?
fi
echo "TM GUARD — commit BLOCKED. tools/tm_guard.py not found."
exit 1
